#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <mouse-gesture.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー定義

#define MOUSE 1
#define NUMBER 2
#define SYMBOL 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6
#define CMDTAP 7
#define GESTURE 8

// 書き込みコマンド
// git pull | ./flash_l.sh 左用
// git pull | ./flash_r.sh 右用

// マウスジェスチャー（SYMBOL レイヤー中 = &lt_k SYMBOL LANG1 長押し中にボールで描く）

&zip_mouse_gesture {
    stroke-size = <70>;   // 1方向と判定する移動量。小さいほど少ない操作で反応（タブジェスチャーと同じ）
    gesture-cooldown-ms = <300>;   // 発動後、次のジェスチャーを受け付けない時間（既定 500）
    enable-eager-mode;
    always-active;       // SYMBOL レイヤーの間だけこの processor が呼ばれるので常時有効でよい
    suppress-movement;   // ジェスチャー中はカーソルを動かさない
    mission_control {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(UP)>;
    };

    app_expose {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LC(DOWN)>;
    };

    desktop_left {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LC(RIGHT)>;     // 右のデスクトップへ
    };

    desktop_right {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LC(LEFT)>;      // 左のデスクトップへ
    };
};

// タブ移動ジェスチャー（GESTURE レイヤー中 = F / L キー長押し中にボールで描く）

/ {
    input_processors {
        zip_tab_gesture: zip_tab_gesture {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;
            stroke-size = <70>;            // 1回のタブ移動に必要なボールの量
            gesture-cooldown-ms = <100>;   // 連続でタブ移動するときの間隔（短いほど速く次へ進む）
            enable-eager-mode;
            always-active;
            suppress-movement;

            prev_tab {
                pattern = <GESTURE_RIGHT>;
                bindings = <&kp LG(LA(LEFT))>;  // 前のタブ（Cmd+Option+←）
            };

            next_tab {
                pattern = <GESTURE_LEFT>;
                bindings = <&kp LG(LA(RIGHT))>; // 次のタブ（Cmd+Option+→）
            };

            reload_tab {
                pattern = <GESTURE_UP>;
                bindings = <&kp LG(R)>;         // 再読み込み（Cmd+R）。上→下と前半が重なるため idle-timeout 後に発動
            };

            close_tab {
                pattern = <GESTURE_UP GESTURE_DOWN>;
                bindings = <&kp LG(W)>;         // タブを閉じる（Cmd+W）：上に弾いて戻す
            };

            back_tab {
                pattern = <GESTURE_DOWN>;
                bindings = <&kp LG(LEFT)>;      // 戻る（Cmd+←）。下→上と前半が重なるため idle-timeout 後に発動
            };

            forward_tab {
                pattern = <GESTURE_DOWN GESTURE_UP>;
                bindings = <&kp LG(RIGHT)>;     // 進む（Cmd+→）：下に弾いて戻す
            };
        };
    };
};

&trackball_listener {
    tab_gesture {
        layers = <GESTURE>;
        input-processors = <&zip_tab_gesture>;
    };

    gesture {
        layers = <SYMBOL>;
        input-processors = <&zip_mouse_gesture>;
    };

    scroller {
        layers = <FUNCTION SCROLL>;
        input-processors = <
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    macros {
        // 英数を送って CMDTAP を 300ms 有効化（cmd_eisu のタップ側から使う）
        macro_eisu_cmdtap: macro_eisu_cmdtap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings =
                <&macro_tap>,
                <&kp LANG2>,
                <&sl_cmdtap CMDTAP>;
        };

        /* ()を入力する */

        macro_parens: macro_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LPAR &kp RPAR>;
        };

        /* []を入力する */

        macro_brackets: macro_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBKT &kp RBKT>;
        };

        /* {}を入力する */

        macro_braces: macro_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBRC &kp RBRC>;
        };

        macro_if: if {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp SPACE &kp LBRC &kp RBRC>;
            label = "IF";
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ============================================================
           CATEGORY: MOUSE & SYSTEM (CamelCase)
           =========================================================== */
        // Bluetoothレイヤー(6)呼び出し : 右端縦3キー同時押し

        BluetoothLayer {
            bindings = <&mo WIRELESS>;
            key-positions = <40 38 39>;
        };

        c_boot {
            bindings = <&bootloader>;
            key-positions = <6 7 8 9>;   // U I O P
        };

        combo_sqt {
            bindings = <&kp SQT>;
            key-positions = <18 17>;
        };

        combo_semi {
            bindings = <&kp SEMI>;
            key-positions = <17 16>;
        };

        combo_slash {
            bindings = <&kp SLASH>;
            key-positions = <27 28>;
        };

        combo_grave {
            bindings = <&kp GRAVE>;
            key-positions = <7 8>;
        };

        combo_m_if {
            bindings = <&macro_if>;
            key-positions = <16 17 13 12>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <16 18>;
            timeout-ms = <60>;
        };

        combo_back_slash {
            bindings = <&kp BSLH>;
            key-positions = <26 27>;   // M + ,
        };

        combo_at {
            bindings = <&kp AT>;
            key-positions = <5 6>;
        };

        combo_ret {
            bindings = <&kp RET>;       // D+F 同時押しで Enter
            key-positions = <12 13>;
        };

        combo_eisu {
            bindings = <&kp LANG2>;     // S+D 同時押しで 英数
            key-positions = <11 12>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // 300ms だけ有効な sticky layer（cmd_eisu タップ後の2回目押しを拾う用）

        sl_cmdtap: sl_cmdtap {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <300>;
            bindings = <&mo>;
        };

        // Cmd/英数キー用 Hold-Tap。使い方: &cmd_eisu LGUI 0
        //   長押し: Cmd / タップ: 英数（＋CMDTAP を 300ms 有効化）
        //   タップ直後にもう一度押し続ける: Shift、もう一度タップ: かな（CMDTAP 上の &hm LSHIFT LANG1）

        cmd_eisu: cmd_eisu {
            compatible = "zmk,behavior-hold-tap";
            label = "CMD_EISU";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            // quick-tap は外す（英数タップ直後の Cmd+C 等がタップ扱いになるため）
            flavor = "hold-preferred";
            bindings = <&kp>, <&macro_eisu_cmdtap>;
        };

        // 一般的なHold-Tap (Hold: Modifier, Tap: Key)

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            #binding-cells = <2>;
            tapping-term-ms = <195>;

            // quick-tap-ms = <190>;

            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };

        // BSPC 用 Hold-Tap (Hold: Shift, Tap: BSPC)。タップの BSPC を優先する設定
        // tap-preferred: tapping-term を超えて押し続けた時だけ Shift（途中で他キーを押してもタップのまま）
        // quick-tap: タップ直後にもう一度押し続けると BSPC のリピート
        // require-prior-idle: タイピング中の連続入力では Shift にしない

        bs_sft: bs_sft {
            compatible = "zmk,behavior-hold-tap";
            label = "BS_SFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // 一般的なLayer-Tap (Hold: Layer, Tap: Key)

        lt_k: lt_k {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_K";
            #binding-cells = <2>;
            tapping-term-ms = <195>;
            flavor = "hold-preferred";
            hold-while-undecided;   // 押した瞬間にレイヤーを有効にし、ジェスチャーをすぐ始められるようにする
            // quick-tap-ms = <10>;

            bindings = <&mo>, <&kp>;
        };

        // 修飾キー用 Hold-Tap（Z/X/C/DOT/EQUAL）

        st: st {
            compatible = "zmk,behavior-hold-tap";
            label = "ST";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // スペース用 Layer-Tap (Hold: FUNCTION, Tap: SPACE)

        stl: stl {
            compatible = "zmk,behavior-hold-tap";
            label = "STL";
            #binding-cells = <2>;

            // CLine46 の slt と同じ値

            tapping-term-ms = <170>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <140>;
            flavor = "balanced";

            // 押した瞬間から FUNCTION を有効にし、ボールを動かすとすぐスクロールになるようにする。
            // タップと判定されたら FUNCTION を解除してから SPACE を送る。押下中の他キーは判定後に処理される

            hold-while-undecided;
            bindings = <&mo>, <&kp>;
        };

        // 文字キー用 Layer-Tap（K: SCROLL / F・L: GESTURE）
        // 押した瞬間からレイヤーを有効にし、長押し中にボールを動かすとスクロール・タブジェスチャーになる
        // tap-preferred + require-prior-idle でタイピング中は文字のまま

        l_scrl: l_scrl {
            compatible = "zmk,behavior-hold-tap";
            label = "L_SCRL";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-while-undecided;
            bindings = <&mo>, <&kp>;
        };

        // マウスボタン用 Layer-Tap（MOUSE レイヤーの J: タップ MB2 / 長押し SCROLL）
        // 押した瞬間からレイヤーを有効にし、長押し中にボールを動かすとすぐスクロールになる

        mb_lt: mb_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "MB_LT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-while-undecided;
            bindings = <&mo>, <&mkp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //0 デフォルト
        // 右下2キー: 前のタブ / 次のタブ（Cmd+Option+← / →）

        default_layer {
            bindings = <
&kp Q         &kp W        &kp E       &kp R               &kp T                                              &kp Y             &kp U  &kp I      &kp O          &kp P
&kp A         &kp S        &kp D       &l_scrl GESTURE F   &kp G                                              &kp H             &kp J  &l_scrl SCROLL K      &l_scrl GESTURE L  &kp MINUS
&st LSHIFT Z  &st LCTRL X  &st LALT C  &kp V               &kp B                                              &kp N             &kp M  &kp COMMA  &st RCTRL DOT  &st RSHIFT EQUAL
&mo FUNCTION  &kp LCTRL    &kp LALT    &lt_k SYMBOL LANG1  &cmd_eisu LGUI 0  &stl FUNCTION SPACE    &bs_sft RSHIFT BSPC  &lt_k NUMBER RET         &kp LG(LA(LEFT))  &kp LG(LA(RIGHT))  &hm RSHIFT ESC
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        //1 マウス操作用

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans      &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mb_lt SCROLL MB2  &mkp MB1  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans      &trans
            >;
        };

        //2 数字・基本記号・矢印キー
        // 右親指（BSPC）の負担を減らすため、左手の D/F 位置に DEL / BSPC を置く

        NUMBER {
            bindings = <
&kp N1    &kp N2     &kp N3    &kp N4    &kp N5                           &kp N6    &kp N7    &kp N8  &kp N9     &kp N0
&kp EXCL  &kp QMARK  &kp DEL   &kp BSPC  &macro_braces                    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&trans    &trans     &kp LBKT  &kp RBKT  &macro_parens                    &kp ESC   &kp TAB   &trans  &trans     &trans
&trans    &trans     &trans    &trans    &trans         &trans    &trans  &trans              &trans  &trans     &trans
            >;

            sensor-bindings = <&re_kp C_VOL_DN C_VOL_UP>;
        };

        //3 記号

        SYMBOL {
            bindings = <
&kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                          &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR
&kp GRAVE  &kp TILDE  &kp LBKT  &kp RBKT  &macro_brackets                    &kp SQT    &kp DQT    &kp SEMI   &kp COLON  &kp UNDER
&kp BSLH   &kp PIPE   &kp LBRC  &kp RBRC  &macro_parens                      &kp PLUS   &kp QMARK  &kp LT     &kp GT     &kp SLASH
&trans     &trans     &trans    &trans    &trans           &trans    &trans  &trans                &trans     &trans     &trans
            >;

            sensor-bindings = <&re_kp C_BRI_DN C_BRI_UP>;
        };

        //4 F1〜F12・テンキー

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp N0
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &kp SLASH  &kp N4  &kp N5  &kp N6  &trans
&trans  &trans  &trans  &kp F11  &kp F12                    &kp UNDER  &kp N1  &kp N2  &kp N3  &trans
&trans  &trans  &trans  &trans   &trans   &trans    &trans  &trans             &trans  &trans  &trans
            >;
        };

        //5 スクロール操作用

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LG(W)  &kp LG(LEFT)          &trans  &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        //6 通信・システム設定

        WIRELESS {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &trans          &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                               &trans          &trans  &trans  &trans  &trans
&bt BT_CLR      &trans        &trans        &trans        &trans                               &trans          &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock          &trans  &trans  &trans
            >;
        };

        //7 cmd_eisu タップ直後 300ms だけ有効。同じキーを押し続けると Shift（タップならかな）

        CMDTAP {
            bindings = <
&trans  &trans  &trans  &trans  &trans                               &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                               &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                               &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &hm LSHIFT LANG1  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };

        //8 F / L 長押し中のタブ移動ジェスチャー用（キーは全て透過）

        GESTURE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };
    };
};
