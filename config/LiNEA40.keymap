#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

// 書き込みコマンド
// git pull | ./flash_l.sh 左用
// git pull | ./flash_r.sh 右用
//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;

        // スクロールを3倍速にする

        input-processors = <
            &zip_wheel_scaler 4 1
        >;
    };

    speed_down {
        layers = <MARK>;

        // スクロールを?倍速にする

        input-processors = <
            &zip_wheel_scaler 1 3
        >;
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors = <
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        CenterClick {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <8 7>;
        };

        bs {
            bindings = <&kp BSPC>;
            key-positions = <16 17>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <16 15>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <18 16>;
        };

        kp {
            bindings = <&kp DEL>;
            key-positions = <9 8>;
        };

        bluetooth_layer {
            bindings = <&mo 6>;
            key-positions = <40 39 38>;
        };

        cursor_layer {
            bindings = <&mo 3>;
            key-positions = <16 19>;
        };

        alt_bs {
            bindings = <&kp LA(BSPC)>;
            key-positions = <6 7>;
        };

        shift_tab {
            bindings = <&kp RS(TAB)>;
            key-positions = <6 5>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // タップで英数、ダブルタップでかな

        td_enjp: td_enjp {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ENJP";
            #binding-cells = <0>;
            tapping-term-ms = <275>;
            bindings = <&kp LANG2>, <&kp LANG1>;
        };

        // 長押しGUI、タップで英数かな切り替え

        gui_en: gui_en {
            compatible = "zmk,behavior-hold-tap";
            label = "GUI_EN";
            #binding-cells = <2>;
            tapping-term-ms = <130>;
            flavor = "balanced";
            hold-trigger-on-release;
            bindings = <&kp>, <&td_enjp>;
        };

        // 一般的なHold-Tap (Hold: Modifier, Tap: Key)

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };

        // 一般的なLayer-Tap (Hold: Layer, Tap: Key)

        lt_k: lt_k {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_K";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // スペース用Hold-Tap

        st: st {
            compatible = "zmk,behavior-hold-tap";
            label = "ST";
            #binding-cells = <2>;
            tapping-term-ms = <195>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Ctrl併用時に単語削除(Alt+BS)化

        bs_m: bs_m {
            compatible = "zmk,behavior-mod-morph";
            label = "BS_M";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp LA(BSPC)>;

            mods = <(MOD_LCTL)>;
        };

        // 右親指用：長押しLayer 1、タップBSPC（Ctrl時は単語削除）、連打長押しでLayer優先

        l1_bs: l1_bs {
            compatible = "zmk,behavior-hold-tap";
            label = "L1_BS";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "hold-preferred";
            quick-tap-ms = <0>; // 連打時のBS長押しを禁止
            bindings = <&mo>, <&bs_m>;
        };

        stl: stl {
            compatible = "zmk,behavior-hold-tap";
            label = "STL";
            #binding-cells = <2>;
            tapping-term-ms = <195>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W      &kp E     &kp R    &kp T                                          &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A          &kp S      &kp D     &kp F    &kp G                                          &kp H          &kp J  &kp K      &kp L    &kp Z
&hm LSHFT TAB  &kp X      &kp C     &kp V    &kp B                                          &kp N          &kp M  &kp COMMA  &kp DOT  &hm RSHFT BSPC
&kp LALT       &kp LCTRL  &kp CAPS  &kp INS  &hm LCMD LANG2  &stl 4 SPACE    &lt_k 4 ENTER  &lt_k 2 LANG1         &kp SEMI   &kp SQT  &kp SLASH
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB2  &mkp MB1  &mo 5   &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans  &trans
            >;
        };

        //2

        MARK {
            bindings = <
&kp N1     &kp N2         &kp N3    &kp N4    &kp N5                       &kp N6    &kp N7    &kp N8  &kp N9     &kp N0
&kp SLASH  &kp BACKSLASH  &kp LBKT  &kp RBKT  &kp GRAVE                    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp SEMI
&trans     &trans         &trans    &trans    &trans                       &kp SQT   &kp SQT   &trans  &trans     &trans
&trans     &trans         &trans    &trans    &trans     &trans    &trans  &trans              &trans  &trans     &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        //3

        CURSOR {
            bindings = <
&trans    &kp LC(LG(LEFT))  &kp UP    &kp LC(LG(RIGHT))  &trans                       &kp KP_MULTIPLY  &kp N7  &kp N8   &kp N9     &kp KP_PLUS
&trans    &kp LEFT          &kp DOWN  &kp RIGHT          &trans                       &kp KP_SLASH     &kp N4  &kp N5   &kp N6     &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN     &kp END   &kp PAGE_UP        &trans                       &kp UNDER        &kp N1  &kp N2   &kp N3     &kp ENTER
&trans    &trans            &trans    &trans             &trans  &trans    &kp ENTER  &kp N0                   &kp DOT  &kp ENTER  &kp QUESTION
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        //4

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp N0
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &kp SLASH  &kp N4  &kp N5  &kp N6  &trans
&trans  &trans  &trans  &kp F11  &kp F12                    &kp UNDER  &kp N1  &kp N2  &kp N3  &trans
&trans  &trans  &trans  &trans   &trans   &trans    &trans  &kp N0             &trans  &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        //5

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LG(W)  &kp LG(LEFT)          &trans  &trans  &trans
            >;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &trans          &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                               &trans          &trans  &trans  &trans  &trans
&bt BT_CLR      &trans        &trans        &trans        &trans                               &trans          &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock          &trans  &trans  &trans
            >;
        };
    };
};
