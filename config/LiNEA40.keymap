#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー定義

#define MOUSE 1
#define NUMBER 2
#define SYMBOL 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

// 書き込みコマンド
// git pull | ./flash_l.sh 左用
// git pull | ./flash_r.sh 右用
//mouse cursol
// &mmv {
//     delay-ms = <20>;
//     trigger-period-ms = <5>;
//     time-to-max-speed-ms = <100>;
//     acceleration-exponent = <2>;
// };
// //mouse scroll
// &msc {
//     delay-ms = <3>;
//     trigger-period-ms = <3>;
//     time-to-max-speed-ms = <100>;
//     acceleration-exponent = <30>;
// };

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    // speed_up {
    //     layers = <FUNCTION>;
    //     // スクロールを3倍速にする
    //     input-processors = <
    //         &zip_wheel_scaler 4 1
    //     >;
    // };
    // speed_down {
    //     layers = <NUMBER>;
    //     // スクロールを?倍速にする
    //     input-processors = <
    //         &zip_wheel_scaler 1 3
    //     >;
    // };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors = <
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    macros {
        /* ()を入力してカーソルを中に戻す */

        macro_parens: macro_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };

        /* []を入力してカーソルを中に戻す */

        macro_brackets: macro_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };

        /* {}を入力してカーソルを中に戻す */

        macro_braces: macro_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };

        /* <>を入力してカーソルを中に戻す */

        macro_angles: macro_angles {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LT &kp GT &kp LEFT>;
        };

        /* ''を入力してカーソルを中に戻す */

        macro_squotes: macro_squotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp SQT &kp SQT &kp LEFT>;
        };

        /* ""を入力してカーソルを中に戻す */

        macro_dquotes: macro_dquotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
        };

        macro_if: if {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp SPACE &kp LBRC &kp RBRC>;
            label = "IF";
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ============================================================
           CATEGORY: MOUSE & SYSTEM (CamelCase)
           =========================================================== */
        // 左クリック : 右手ホーム段 [J] + [K]

        CenterClick {
            bindings = <&mkp MB1>;
            key-positions = <17 26>;
        };

        // 右クリック : 右手ホーム段 [J] + [K] の上段キー

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <16 25>;
        };

        // Bluetoothレイヤー(6)呼び出し : 最下段3キー同時押し

        BluetoothLayer {
            bindings = <&mo WIRELESS>;
            key-positions = <39 40 38>;
        };

        /* ============================================================
           CATEGORY: SYMBOL MACROS (snake_case)
           =========================================================== */
        /* --- 右手側：主要な括弧 --- */
        // ( ) : 右手上段 [U] + [I]

        combo_parens {
            bindings = <&macro_parens>;
            key-positions = <6 7 8>;
        };

        // [ ] : 右手ホーム段 [J] + [K]

        combo_brackets {
            bindings = <&macro_brackets>;
            key-positions = <16 17 18>;
        };

        // { } : 右手下段 [M] + [,]

        combo_braces {
            bindings = <&macro_braces>;
            key-positions = <26 27 28>;
        };

        // < > : 右手下段 [,] + [.]

        combo_angles {
            bindings = <&macro_angles>;
            key-positions = <27 28>;
        };

        /* --- 左手側：引用符 --- */
        // ' ' : 左手ホーム段 [D] + [F]

        combo_squotes {
            bindings = <&macro_squotes>;
            key-positions = <6 5>;
        };

        // " " : 左手ホーム段 [S] + [D]

        combo_dquotes {
            bindings = <&macro_dquotes>;
            key-positions = <15 16>;
        };

        /* ============================================================
           CATEGORY: EDITING & SPECIAL (snake_case)
           =========================================================== */
        // Backspace : 右手ホーム段 [K] + [L]

        combo_semi {
            bindings = <&kp SEMI>;
            key-positions = <17 18>;
        };

        // Delete : 右手上段端付近

        combo_sql {
            bindings = <&kp SQT>;
            key-positions = <8 7>;
        };

        // Escape : 右手ホーム段 [K] + [右端キー]

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <18 16>;
        };

        m_if {
            bindings = <&macro_if>;
            key-positions = <3 2>;
        };

        combo_slash {
            bindings = <&kp SLASH>;
            key-positions = <26 27>;
        };

        bs {
            bindings = <&kp BSPC>;
            key-positions = <16 17>;
        };

        altbs {
            bindings = <&kp LA(BSPC)>;
            key-positions = <7 6>;
        };
    };

    behaviors {
        // Caps Lockをダブルタップで発動させる設定

        td_caps: td_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_CAPS";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&kp CAPS>;

            // 1タップ目は何もしない（あるいは別のキー）、2タップでCaps
        };

        // カスタムHold-Tap: ホールドでLCMD、タップでLANG2、ダブルタップでCaps
        // ※gui_enをベースに、タップ部分をtd_capsと組み合わせたような挙動にします

        hm_caps: hm_caps {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_CAPS";
            #binding-cells = <2>;

            // ホールド判定を少し短めにして、Commandとしての反応を速くする

            tapping-term-ms = <200>;

            // 連続入力時の判定を安定させる

            quick-tap-ms = <175>;

            // タップ判定よりもホールド（Command）を優先

            flavor = "hold-preferred";
            bindings = <&kp>, <&td_caps_lang>;
        };

        // LANG2とCAPSのタップダンス

        td_caps_lang: td_caps_lang {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_CAPS_LANG";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LANG2>, <&kp CAPS>;

            // 1タップで英数、2タップでCaps
        };

        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // タップで英数、ダブルタップでかな

        td_enjp: td_enjp {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ENJP";
            #binding-cells = <0>;
            tapping-term-ms = <275>;
            bindings = <&kp LANG2>, <&kp LANG1>;
        };

        // 長押しGUI、タップで英数かな切り替え

        gui_en: gui_en {
            compatible = "zmk,behavior-hold-tap";
            label = "GUI_EN";
            #binding-cells = <2>;
            tapping-term-ms = <130>;
            flavor = "balanced";
            hold-trigger-on-release;
            bindings = <&kp>, <&td_enjp>;
        };

        // 一般的なHold-Tap (Hold: Modifier, Tap: Key)

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <190>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };

        // 一般的なLayer-Tap (Hold: Layer, Tap: Key)

        lt_k: lt_k {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_K";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // スペース用Hold-Tap

        st: st {
            compatible = "zmk,behavior-hold-tap";
            label = "ST";
            #binding-cells = <2>;
            tapping-term-ms = <195>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Ctrl併用時に単語削除(Alt+BS)化

        bs_m: bs_m {
            compatible = "zmk,behavior-mod-morph";
            label = "BS_M";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp LA(BSPC)>;

            mods = <(MOD_LCTL)>;
        };

        // 右親指用：長押しLayer 1、タップBSPC（Ctrl時は単語削除）、連打長押しでLayer優先

        l1_bs: l1_bs {
            compatible = "zmk,behavior-hold-tap";
            label = "L1_BS";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "hold-preferred";
            quick-tap-ms = <0>; // 連打時のBS長押しを禁止
            bindings = <&mo>, <&bs_m>;
        };

        stl: stl {
            compatible = "zmk,behavior-hold-tap";
            label = "STL";
            #binding-cells = <2>;
            tapping-term-ms = <195>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W      &kp E     &kp R    &kp T                                                 &kp Y               &kp U  &kp I      &kp O     &kp P
&kp A        &kp S      &kp D     &kp F    &kp G                                                 &kp H               &kp J  &kp K      &kp L     &kp MINUS
&hm LSHFT X  &kp Z      &kp C     &kp V    &kp B                                                 &kp N               &kp M  &kp COMMA  &kp DOT   &hm RSHFT EQUAL
&kp LALT     &kp LCTRL  &kp CAPS  &kp INS  &hm LCMD LANG2  &stl FUNCTION SPACE    &lt_k 3 ENTER  &lt_k NUMBER LANG1         &kp LBKT   &kp RBKT  &kp SLASH
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        //1 マウス操作用

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans      &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB2  &mkp MB1  &mo SCROLL  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans      &trans
            >;
        };

        //2 数字・基本記号・矢印キー

        NUMBER {
            bindings = <
&kp N1     &kp N2    &kp N3   &kp N4    &kp N5                       &kp N6    &kp N7    &kp N8  &kp N9     &kp N0
&kp SLASH  &kp BSLH  &kp SQT  &kp SEMI  &kp GRAVE                    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&trans     &trans    &trans   &trans    &trans                       &kp BSPC  &kp TAB   &trans  &trans     &trans
&trans     &trans    &trans   &trans    &trans     &trans    &trans  &trans              &trans  &trans     &trans
            >;

            sensor-bindings = <&re_kp C_VOL_DN C_VOL_UP>;
        };

        //3 NUMBERのOption(Alt)付き矢印

        SYMBOL {
            bindings = <
&kp EXCL   &kp AT    &kp HASH  &kp DLLR   &kp PRCNT                    &kp CARET     &kp AMPS      &kp ASTRK   &kp LPAR       &kp RPAR
&kp QMARK  &kp PIPE  &kp DQT   &kp COLON  &kp TILDE                    &kp LA(LEFT)  &kp LA(DOWN)  &kp LA(UP)  &kp LA(RIGHT)  &trans
&trans     &trans    &trans    &trans     &trans                       &trans        &trans        &kp LT      &kp GT         &trans
&trans     &trans    &trans    &trans     &trans     &trans    &trans  &trans                      &trans      &trans         &trans
            >;

            sensor-bindings = <&re_kp C_BRI_DN C_BRI_UP>;
        };

        //4 F1〜F12・テンキー

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &kp ASTRK  &kp N7  &kp N8  &kp N9  &kp N0
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &kp SLASH  &kp N4  &kp N5  &kp N6  &trans
&trans  &trans  &trans  &kp F11  &kp F12                    &kp UNDER  &kp N1  &kp N2  &kp N3  &trans
&trans  &trans  &trans  &trans   &trans   &trans    &trans  &kp N0             &trans  &trans  &trans
            >;

            sensor-bindings = <&re_kp C_BRI_DN C_BRI_UP>;
        };

        //5 スクロール操作用

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LG(W)  &kp LG(LEFT)          &trans  &trans  &trans
            >;

            sensor-bindings = <&re_kp LA(LG(RIGHT)) LA(LG(LEFT))>;
        };

        //6 通信・システム設定

        WIRELESS {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &trans          &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                               &trans          &trans  &trans  &trans  &trans
&bt BT_CLR      &trans        &trans        &trans        &trans                               &trans          &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock          &trans  &trans  &trans
            >;
        };
    };
};
